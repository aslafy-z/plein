# Build-time overrides. Copy the ones you need into `.env.local` (gitignored)
# or set them in the environment the build runs in — Vite reads both, and
# `.env.local` wins. Everything here is baked into the client bundle, so it is
# public: no secret belongs in this file.

# CARTO basemap key, used by the map and by the dev tile proxy. Unset, the app
# uses the key it ships with (src/lib/cartoKey.ts) — set this to draw the
# tiles on your own CARTO account instead.
VITE_CARTO_KEY=
